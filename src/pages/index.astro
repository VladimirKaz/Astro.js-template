---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
---

<BaseLayout title="Главная" description="Добро пожаловать в Astro Starter">
  <div class="hero container">
    <h1 class="hero__title">Привет, Astro! 👋</h1>

    <p class="hero__text">
      Это стартовый шаблон. Редактируй <code>src/pages/index.astro</code>, чтобы
      начать работу.
    </p>

    <a
      href="https://docs.astro.build"
      class="hero__btn"
      target="_blank"
      rel="noopener"
    >
      Документация Astro →
    </a>

    <section class="section container">
      <div class="container">
        <h1>Кнопки</h1>

        <div
          style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2rem;"
        >
          <Button>Primary</Button>
          <Button variant="outline">Outline</Button>
          <Button variant="ghost">Ghost</Button>
        </div>

        <div
          style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2rem;"
        >
          <Button size="sm">Small</Button>
          <Button size="md">Medium</Button>
          <Button size="lg">Large</Button>
        </div>

        <div
          style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2rem;"
        >
          <Button href="/about">Ссылка</Button>
          <Button disabled>Отключена</Button>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<!-- STYLES -->
<style>
  .hero {
    padding: 5rem 1rem;
    text-align: center;
  }

  .hero__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 1rem;
    font-weight: 800;
  }

  .hero__text {
    color: var(--color-text-muted);
    font-size: 1.125rem;
    margin-bottom: 2rem;
  }

  .hero__text code {
    background: var(--color-bg-alt);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.95em;
  }

  .hero__btn {
    display: inline-block;
    background: var(--color-primary);
    color: #fff;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius);
    font-weight: 600;
    transition: background var(--transition);
  }

  .hero__btn:hover {
    background: var(--color-primary-hover);
  }
</style>
